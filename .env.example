# Required in production; use a long random secret.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: enables real visual analysis on uploaded issue photos.
# Create an API key in your OpenAI developer account and keep it private.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional: set to a persistent disk mount path in production.
UPLOAD_DIR=uploads

# Optional: force free local rule-based analysis even when an API key exists.
# Leave 0 to use OpenAI when available and automatically fall back on missing credits.
COREFIX_DEMO_MODE=0
